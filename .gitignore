# ==============================================================================
# Git Ignore for ApexMiner Studio
# ==============================================================================

# Mining Engine Binaries (Managed by setup_binaries.py)
bin/*
!bin/.gitkeep
temp_*

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Distribution & Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Logs & Runtime Dumps
*.log
nohup.out

# IDEs & OS Files
.idea/
.vscode/
.DS_Store
*.swp
*~
thumbs.db

# User Configuration Overrides
.config/
